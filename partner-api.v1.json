      },
      "FulfilConflictProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_state",
              "idempotency_key_conflict"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "FulfilConflictProblem"
      }
    },
    "parameters": {
      "ApplicationId": {
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "required": true,
        "name": "applicationId",
        "in": "path"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request does not match the contract.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid partner API key.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "email_conflict when the partnerReference belongs to a different customer email; invalid_state when the application has ended, or when the quote changes and the application is not created or in progress.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "The quote is refused: currency_mismatch (not GBP, or not one currency), invalid_line_item (detail names the item and the rule), total_out_of_range (our total including VAT is not above zero, or is over 1000000000, £10,000,000.00), or total_mismatch (expectedTotal differs from ours; totals carries ours). product_unavailable and amount_out_of_bounds are reserved.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/QuoteProblem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "insufficient_scope: the key is valid but lacks a scope this request needs, named in detail. Nothing was written.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ScopeProblem"
            }
          }
        }
      }
    }
  }
}