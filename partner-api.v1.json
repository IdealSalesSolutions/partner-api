    "/v1/applications/{applicationId}/amendments": {
      "post": {
        "operationId": "amendApplication",
        "security": [
          {
            "partnerApiKey": [
              "applications:amend"
            ]
          }
        ],
        "summary": "Replace the Quote.",
        "description": "The quote sent replaces the Quote in force, whole. Allowed before signing: created, in progress, submitted or approved. From submitted or approved, an amend moves the application back to in_progress and withdraws any submission the lender holds, so the customer is asked again; that is not yet available and answers 501. From any other status, an amend is refused.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AmendApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The Quote was replaced.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "invalid_state when the application is not created, in progress, submitted or approved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "501": {
            "description": "Not yet available.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplementedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/applications/{applicationId}/handoff": {
      "post": {
        "operationId": "issueHandoff",
        "security": [
          {
            "partnerApiKey": [
              "applications:create"
            ]
          }
        ],
        "summary": "Get a fresh handoff URL for the customer.",
        "description": "Each call issues a new single-use URL; earlier ones stay valid until they expire or are used. Refused once the application has ended: declined, withdrawn, cancelled, expired or paid out.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "responses": {
          "201": {
            "description": "A handoff URL was issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Handoff"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "invalid_state when the application has ended.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/applications/{applicationId}/fulfil": {
      "post": {
        "operationId": "fulfilApplication",
        "security": [
          {
            "partnerApiKey": [
              "applications:amend"
            ]
          }
        ],
        "summary": "Request fulfilment.",
        "description": "Tells Ideal the customer has received what they financed, which is what allows the finance to be paid out. Calling this is the only way to start fulfilment: nothing fulfils an application automatically. The request is accepted with 202 and the application stays signed until the lender acknowledges it; it then moves to fulfilled, and your webhook receives application.status_changed from signed to fulfilled. Only an accepted request (202) binds its Idempotency-Key: a retry with the same key then always answers that original 202, whatever the application's state is now. A refused request (404 or 409) stores nothing, so the same key can be used again once the application is ready, and that call gets a fresh answer. While a request is pending, another call with a new key answers 202 with the same state and starts nothing new. Not yet available: this operation currently answers 501.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "A key you choose for this fulfilment request. Only an accepted request (202) binds the key: a retry with the same key then answers that original 202 again, whatever the application's state is now, and starts nothing new. A refused request (404 or 409) stores nothing, so the same key can be used again once the application is ready and gets a fresh answer. A key bound by a 202 for a different application of yours is refused with 409 idempotency_key_conflict."
            },
            "required": true,
            "description": "A key you choose for this fulfilment request. Only an accepted request (202) binds the key: a retry with the same key then answers that original 202 again, whatever the application's state is now, and starts nothing new. A refused request (404 or 409) stores nothing, so the same key can be used again once the application is ready and gets a fresh answer. A key bound by a 202 for a different application of yours is refused with 409 idempotency_key_conflict.",
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "responses": {
          "202": {
            "description": "Fulfilment requested. The application is still signed; it becomes fulfilled when the lender acknowledges, signalled by your webhook. This response binds the Idempotency-Key: a retry with the same key gets this original response again, even once the application has moved on.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "invalid_state when the application isn't signed and no earlier 202 for it bound the Idempotency-Key; idempotency_key_conflict when the Idempotency-Key is bound by a 202 for a different application of yours. A 409 stores nothing: the key stays unbound, and a later call with it gets a fresh answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/FulfilConflictProblem"
                }
              }
            }
          },
          "501": {
            "description": "Not yet available.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplementedProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "applicationEvent": {
      "post": {
        "operationId": "applicationEventWebhook",
        "summary": "Sent to the partner's webhook URL. HMAC-signed.",
        "description": "Ideal POSTs each event to the webhook URL your partner_admin registers in the partner admin. Each delivery is signed: X-Signature is `t=<unix seconds>,v1=<hex>`, where v1 is HMAC-SHA256 keyed with your webhook secret over the string `<t>.<raw body>`, in lowercase hex. To verify: take the raw request bytes before parsing, compute the HMAC over t, a full stop and those bytes, compare it with v1 in constant time, and reject the delivery if they differ or if t is more than 5 minutes old. The webhook secret is your partner's own, shown once to a partner_admin in the partner admin, and can be rotated there. A delivery is retried with backoff until you answer 2XX, and every retry carries the same eventId.",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "t=<unix seconds>,v1=<HMAC-SHA256 of \"<t>.<raw body>\" keyed with your webhook secret, lowercase hex>.",
              "example": "t=1760261400,v1=5d41402abc4b2a76b9719d911017c592ae2f1f6a0c3e0c9b0e3c1f1e2d3c4b5a"
            },
            "required": true,
            "description": "t=<unix seconds>,v1=<HMAC-SHA256 of \"<t>.<raw body>\" keyed with your webhook secret, lowercase hex>.",
            "name": "X-Signature",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Acknowledged."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "partnerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A partner API key as a bearer token. Each operation names the scope it needs: applications:create, applications:read or applications:amend."
      }
    },
    "schemas": {
      "WebhookEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StatusChangedEvent"
          },
          {
            "$ref": "#/components/schemas/AmendedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "application.status_changed": "#/components/schemas/StatusChangedEvent",
            "application.amended": "#/components/schemas/AmendedEvent"
          }
        },
        "title": "WebhookEvent"
      },
      "StatusChangedEvent": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "This event's own id. It is the same on every retry and replay of the event: use it to de-duplicate."
          },
          "type": {
            "type": "string",
            "const": "application.status_changed"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Ideal's Application id, the id createApplication returned. Never a lender's reference."
          },
          "partnerReference": {
            "type": "string"
          },
          "from": {
            "$ref": "#/components/schemas/Status"
          },
          "to": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "eventId",
          "type",
          "occurredAt",
          "applicationId",
          "partnerReference",
          "from",
          "to"
        ],
        "title": "StatusChangedEvent",
        "description": "Status can move backwards, always to in_progress: on an amend (from submitted or approved), when Ideal returns a submitted application to the customer, and when an approved offer lapses."
      },
      "Status": {
        "type": "string",
        "title": "ApplicationStatus",
        "description": "referred is reserved: not sent today.",
        "enum": [
          "created",
          "in_progress",
          "submitted",
          "approved",
          "declined",
          "referred",
          "signed",
          "fulfilled",
          "paid_out",
          "withdrawn",
          "cancelled",
          "expired"
        ]
      },
      "AmendedEvent": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "This event's own id. It is the same on every retry and replay of the event: use it to de-duplicate."
          },
          "type": {
            "type": "string",
            "const": "application.amended"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Ideal's Application id, the id createApplication returned. Never a lender's reference."
          },
          "partnerReference": {
            "type": "string"
          },
          "quote": {
            "type": "object",
            "properties": {
              "total": {
                "$ref": "#/components/schemas/QuoteTotal"
              }
            },
            "required": [
              "total"
            ]
          }
        },
        "required": [
          "eventId",
          "type",
          "occurredAt",
          "applicationId",
          "partnerReference",
          "quote"
        ],
        "title": "AmendedEvent",
        "description": "The Quote was replaced. Its items are read with getApplication."
      },
      "QuoteTotal": {
        "type": "object",
        "properties": {
          "amountVatExclusive": {
            "$ref": "#/components/schemas/Money"
          },
          "amountVat": {
            "$ref": "#/components/schemas/Money"
          },
          "amountVatInclusive": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "amountVatExclusive",
          "amountVat",
          "amountVatInclusive"
        ],
        "title": "QuoteTotal",
        "description": "Computed by Ideal from the items. The amount financed is amountVatInclusive."
      },
      "Money": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000,
            "description": "In pence (minor units): 2345 = £23.45; at least 0, at most 1000000000 (£10,000,000.00).",
            "example": 2345
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217. Only GBP is accepted for now; one currency per quote."
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money"
      },
      "CreatedApplication": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Application"
          },
          {
            "type": "object",
            "properties": {
              "handoffUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "handoffUrl"
            ]
          }
        ],
        "title": "CreatedApplication"
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "partnerReference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "property": {
            "$ref": "#/components/schemas/Property"
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          },
          "timestamps": {
            "$ref": "#/components/schemas/Timestamps"
          }
        },
        "required": [
          "id",
          "partnerReference",
          "status",
          "customer",
          "property",
          "quote",
          "timestamps"
        ],
        "title": "Application"
      },
      "Customer": {
        "type": "object",
        "properties": {
          "title": {
            "$ref": "#/components/schemas/CustomerTitle"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
