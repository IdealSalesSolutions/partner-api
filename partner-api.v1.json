{
  "openapi": "3.1.0",
  "info": {
    "title": "Partner API",
    "version": "1.0.0",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.example.invalid"
    }
  ],
  "security": [
    {
      "partnerApiKey": []
    }
  ],
  "tags": [
    {
      "name": "applications",
      "description": "Applications."
    }
  ],
  "paths": {
    "/v1/applications/{applicationId}/amendments": {
      "post": {
        "operationId": "amendApplication",
        "security": [
          {
            "partnerApiKey": [
              "applications:amend"
            ]
          }
        ],
        "summary": "Add an Amount Revision.",
        "description": "Allowed before signing: created, in progress, submitted or approved. From submitted or approved, an amend moves the application back to in_progress and withdraws any submission the lender holds, so the customer is asked again. From any other status, an amend is refused. Not yet available: this operation currently answers 501.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Amount"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A new Amount Revision was added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "invalid_state when the application is not created, in progress, submitted or approved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "501": {
            "description": "Not yet available.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplementedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/applications": {
      "post": {
        "operationId": "createApplication",
        "security": [
          {
            "partnerApiKey": [
              "applications:create"
            ]
          }
        ],
        "tags": [
          "applications"
        ],
        "summary": "Create an Application, idempotent on partnerReference.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An Application already exists for this partnerReference and customer email. A changed amount or breakdown is an amend and adds an Amount Revision, allowed only while the application is created, in progress, submitted or approved (otherwise 409 invalid_state). From submitted or approved, it moves the application back to in_progress and withdraws any submission the lender holds, so the customer is asked again. A changed name or property address is ignored. Each call returns a fresh handoffUrl.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApplication"
                }
              }
            }
          },
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApplication"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      },
      "get": {
        "operationId": "findApplicationByPartnerReference",
        "security": [
          {
            "partnerApiKey": [
              "applications:read"
            ]
          }
        ],
        "summary": "Find an Application by the partner reference.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "required": true,
            "name": "partnerReference",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The Application with this partnerReference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/applications/{applicationId}/fulfil": {
      "post": {
        "operationId": "fulfilApplication",
        "security": [
          {
            "partnerApiKey": [
              "applications:amend"
            ]
          }
        ],
        "summary": "Request fulfilment.",
        "description": "Tells Ideal the customer has received what they financed, which is what allows the finance to be paid out. Calling this is the only way to start fulfilment: nothing fulfils an application automatically. The request is accepted with 202 and the application stays signed until the lender acknowledges it; it then moves to fulfilled, and your webhook receives application.status_changed from signed to fulfilled. Only an accepted request (202) binds its Idempotency-Key: a retry with the same key then always answers that original 202, whatever the application's state is now. A refused request (404 or 409) stores nothing, so the same key can be used again once the application is ready, and that call gets a fresh answer. While a request is pending, another call with a new key answers 202 with the same state and starts nothing new. Not yet available: this operation currently answers 501.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "A key you choose for this fulfilment request. Only an accepted request (202) binds the key: a retry with the same key then answers that original 202 again, whatever the application's state is now, and starts nothing new. A refused request (404 or 409) stores nothing, so the same key can be used again once the application is ready and gets a fresh answer. A key bound by a 202 for a different application of yours is refused with 409 idempotency_key_conflict."
            },
            "required": true,
            "description": "A key you choose for this fulfilment request. Only an accepted request (202) binds the key: a retry with the same key then answers that original 202 again, whatever the application's state is now, and starts nothing new. A refused request (404 or 409) stores nothing, so the same key can be used again once the application is ready and gets a fresh answer. A key bound by a 202 for a different application of yours is refused with 409 idempotency_key_conflict.",
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "responses": {
          "202": {
            "description": "Fulfilment requested. The application is still signed; it becomes fulfilled when the lender acknowledges, signalled by your webhook. This response binds the Idempotency-Key: a retry with the same key gets this original response again, even once the application has moved on.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "invalid_state when the application isn't signed and no earlier 202 for it bound the Idempotency-Key; idempotency_key_conflict when the Idempotency-Key is bound by a 202 for a different application of yours. A 409 stores nothing: the key stays unbound, and a later call with it gets a fresh answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/FulfilConflictProblem"
                }
              }
            }
          },
          "501": {
            "description": "Not yet available.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplementedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/applications/{applicationId}": {
      "get": {
        "operationId": "getApplication",
        "security": [
          {
            "partnerApiKey": [
              "applications:read"
            ]
          }
        ],
        "summary": "Get an Application.",
        "tags": [
          "applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ApplicationId"
          }
        ],
        "responses": {
          "200": {
            "description": "The Application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "webhooks": {
    "applicationEvent": {
      "post": {
        "operationId": "applicationEventWebhook",
        "summary": "Sent to the partner's webhook URL. HMAC-signed.",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "X-Signature",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Acknowledged."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "partnerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A partner API key as a bearer token. Each operation names the scope it needs: applications:create, applications:read or applications:amend."
      }
    },
    "schemas": {
      "WebhookEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StatusChangedEvent"
          },
          {
            "$ref": "#/components/schemas/AmendedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "application.status_changed": "#/components/schemas/StatusChangedEvent",
            "application.amended": "#/components/schemas/AmendedEvent"
          }
        },
        "title": "WebhookEvent"
      },
      "StatusChangedEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable event id; replays reuse it."
          },
          "type": {
            "type": "string",
            "const": "application.status_changed"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "partnerReference": {
            "type": "string"
          },
          "from": {
            "$ref": "#/components/schemas/Status"
          },
          "to": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "id",
          "type",
          "occurredAt",
          "applicationId",
          "partnerReference",
          "from",
          "to"
        ],
        "title": "StatusChangedEvent",
        "description": "Status can move backwards, always to in_progress: on an amend (from submitted or approved), when Ideal returns a submitted application to the customer, and when an approved offer lapses."
      },
      "Status": {
        "type": "string",
        "title": "ApplicationStatus",
        "description": "referred is reserved: not sent today.",
        "enum": [
          "created",
          "in_progress",
          "submitted",
          "approved",
          "declined",
          "referred",
          "signed",
          "fulfilled",
          "paid_out",
          "withdrawn",
          "cancelled",
          "expired"
        ]
      },
      "AmendedEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "const": "application.amended"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "partnerReference": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "id",
          "type",
          "occurredAt",
          "applicationId",
          "partnerReference",
          "amount"
        ],
        "title": "AmendedEvent"
      },
      "Amount": {
        "type": "object",
        "properties": {
          "totalPence": {
            "type": "integer",
            "minimum": 1,
            "description": "Integer pence."
          },
          "breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "pence": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "label",
                "pence"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "totalPence",
          "breakdown"
        ],
        "title": "Amount"
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "partnerReference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fulfilledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "partnerReference",
          "status",
          "customer",
          "amount",
          "createdAt",
          "updatedAt",
          "fulfilledAt"
        ],
        "title": "Application"
      },
      "Customer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "title": "Customer"
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "unauthorized",
              "not_found",
              "email_conflict",
              "invalid_state",
              "product_unavailable",
              "amount_out_of_bounds"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem"
      },
      "NotImplementedProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number",
            "const": 501
          },
          "code": {
            "type": "string",
            "const": "not_implemented"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "NotImplementedProblem"
      },
      "CreatedApplication": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Application"
          },
          {
            "type": "object",
            "properties": {
              "handoffUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "handoffUrl"
            ]
          }
        ],
        "title": "CreatedApplication"
      },
      "CreateApplicationRequest": {
        "type": "object",
        "properties": {
          "partnerReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "propertyAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "partnerReference",
          "customer",
          "propertyAddress",
          "amount"
        ],
        "title": "CreateApplicationRequest"
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": [
              "string",
              "null"
            ]
          },
          "town": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        },
        "required": [
          "line1",
          "town",
          "postcode"
        ],
        "title": "Address"
      },
      "FulfilConflictProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_state",
              "idempotency_key_conflict"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "FulfilConflictProblem"
      }
    },
    "parameters": {
      "ApplicationId": {
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "required": true,
        "name": "applicationId",
        "in": "path"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request does not match the contract.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid partner API key.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "email_conflict when the partnerReference belongs to a different customer email; invalid_state when the amount changes and the application is not created, in progress, submitted or approved.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "product_unavailable or amount_out_of_bounds.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}